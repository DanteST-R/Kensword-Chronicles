rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário autenticado é Admin ou Sub-Admin
    function isStaff() {
      return request.auth != null && 
        (get(/databases/$(database)/documents/characters/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/characters/$(request.auth.uid)).data.isSubAdmin == true ||
         get(/databases/$(database)/documents/characters/$(request.auth.uid)).data.user_role == 'admin' ||
         get(/databases/$(database)/documents/characters/$(request.auth.uid)).data.user_role == 'sub-admin' ||
         (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.matches('.*dantestr.*')));
    }

    // Regras para Coleção de Personagens
    match /characters/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                    (request.resource.data.status == 'pending' || 
                     request.resource.data.isAdmin == true);
      allow update: if request.auth != null && (
        isStaff() || 
        (request.auth.uid == uid && 
         request.resource.data.status == resource.data.status &&
         request.resource.data.isAdmin == resource.data.isAdmin &&
         request.resource.data.isSubAdmin == resource.data.isSubAdmin)
      );
      allow delete: if request.auth != null && (isStaff() || request.auth.uid == uid);
    }

    // Regras para Coleção de NPCs
    match /npcs/{npcId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Regras para Coleção de Histórias / Missões
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Regras para Coleção de Monstros (Bestiário)
    match /monsters/{monsterId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Regras para Coleção de Organizações
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Regras para Coleção de Notícias/Comunicados
    match /news/{newsId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }
  }
}